modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[objectStorage]
defaultBucketID = "replit-objstore-04a01f73-80fe-4bba-92a5-b3153a98dd6b"

[userenv]

[userenv.shared]
WHOP_COMPANY_ID = "biz_SIRiA5olhGiS4e"
WHOP_PLAN_ID = "plan_8QGhfKh37k1yU"

[nix]
channel = "stable-25_05"
